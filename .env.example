# Add a key for each provider you want to use. Stages without a key fall back to
# the next provider in their list (config/settings.yaml), or to a local model.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Only needed when Ollama is not on its default address.
OLLAMA_API_BASE=

# Optional: Google Books catalogue lookups. Without it the shared anonymous quota applies, which is often used up.
GOOGLE_BOOKS_API_KEY=
